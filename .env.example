# Runtime: use the provider's pooled PostgreSQL URL in production (TLS required).
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST:5432/DATABASE?sslmode=verify-full"
# Provider aliases DATABASE_URL_POOLED and POSTGRES_URL are also supported.
# PRISMA_DATABASE_URL / prisma+postgres URLs are not TCP connections for pg.
# Migrations: direct connection, bypassing the pooler.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=verify-full"
APP_ORIGIN="http://localhost:3000"
# Comma-separated exact storefront origins. Public GETs only; no credentials.
CORS_ORIGINS="http://localhost:3001"
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
